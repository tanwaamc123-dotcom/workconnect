APP_URL=http://127.0.0.1/WorkConnect
APP_ENV=local
APP_TIMEZONE=Asia/Bangkok
APP_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Leave DATABASE_URL empty to use local SQLite.
# Neon/Supabase example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=
DB_SSLMODE=require
MAIL_FROM=hello@workconnect.test
MAIL_TRANSPORT=log
RESEND_API_KEY=
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_OFFSITE_REQUIRED=0
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
